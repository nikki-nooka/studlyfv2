{
  "name": "studlyf-backend",
  "version": "1.0.0",
  "description": "Studlyf Backend - Node.js + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.4.0",
    "rate-limit-redis": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongodb": "^6.9.0",
    "nodemailer": "^6.9.15",
    "groq-sdk": "^0.7.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "pino-http": "^10.3.0",
    "node-cron": "^3.0.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "@sentry/node": "^8.30.0",
    "ioredis": "^5.4.1",
    "http-status-codes": "^2.3.0",
    "hpp": "^0.2.3",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/hpp": "^0.2.6",
    "tsx": "^4.19.1",
    "rimraf": "^6.0.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.11.0",
    "@eslint/js": "^9.11.0",
    "typescript-eslint": "^8.7.0",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
